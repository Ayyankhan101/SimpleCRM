# Required
SECRET_KEY=your-secret-key-generate-with-python-m secrets-token-urlsafe-32
FLASK_ENV=development  # development or production

# Database (required for production, defaults to SQLite for development)
DATABASE_URL=sqlite:///data_analytics.db
# PostgreSQL example: postgresql://user:password@localhost:5432/dataanalytics

# Google OAuth (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5000/api/auth/google/callback

# Frontend URL (used for CORS and OAuth redirect)
FRONTEND_URL=http://localhost:5173
